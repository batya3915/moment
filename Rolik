var DRAW=[s0,s1,s2,s3,s4,s5];
function frame(now){requestAnimationFrame(frame);var dt=Math.min(.05,(now-last)/1000||0);last=now;
if(playing){t+=dt;if(t>=TOTAL){t=TOTAL;playing=false;syncPlay();if(recording)stopRec()}}
var sc=sceneAt(Math.min(t,TOTAL-.0001));chrome(t,sc);
cx.save();DRAW[sc.i](sc.p);cx.restore();
$('prog').style.width=(t/TOTAL*100)+'%';$('tc').textContent=fmtTC(t);
$('now').textContent='0'+(sc.i+1)+' · '+SCENES[sc.i].n;
var chips=document.querySelectorAll('.sc');for(var i=0;i<chips.length;i++)chips[i].classList.toggle('on',i===sc.i);
if(recording)$('bRec').querySelector('.i').textContent='⏹'}
function syncPlay(){$('bPlay').querySelector('.i').textContent=playing?'⏸':'▶';$('bPlay').lastChild.textContent=playing?'Пауза':'Играть'}
function jump(i){var acc=0;for(var k=0;k<i;k++)acc+=SCENES[k].d;t=acc+.0001;playing=true;syncPlay()}
function buildStrip(){var el=$('strip');el.innerHTML=SCENES.map(function(s,i){return '<button class="sc" data-i="'+i+'"><em>0'+(i+1)+'</em>'+s.n+'</button>'}).join('');
el.addEventListener('click',function(e){var b=e.target.closest('.sc');if(b)jump(+b.getAttribute('data-i'))})}
function startRec(){
if(!window.MediaRecorder||!cv.captureStream){toast('Запись не поддерживается — сохрани кадры или сними экран');return}
var mime='video/webm;codecs=vp9';if(!MediaRecorder.isTypeSupported(mime))mime='video/webm;codecs=vp8';if(!MediaRecorder.isTypeSupported(mime))mime='video/webm';
try{var stream=cv.captureStream(30);rec=new MediaRecorder(stream,{mimeType:mime,videoBitsPerSecond:6000000})}catch(e){toast('Не удалось начать запись');return}
recChunks=[];rec.ondataavailable=function(e){if(e.data&&e.data.size)recChunks.push(e.data)};
rec.onstop=function(){recording=false;$('rec').classList.remove('on');$('bRec').classList.remove('danger');$('bRec').classList.add('primary');$('bRec').querySelector('.i').textContent='⏺';$('bRec').lastChild.textContent='Записать';
var blob=new Blob(recChunks,{type:'video/webm'});if(recURL)URL.revokeObjectURL(recURL);recURL=URL.createObjectURL(blob);
$('bSave').disabled=false;$('bShare').disabled=false;
var a=document.createElement('a');a.href=recURL;a.download='moment-team-reel.webm';document.body.appendChild(a);a.click();a.remove();
toast('Ролик сохранён: moment-team-reel.webm')};
t=0;playing=true;syncPlay();recording=true;rec.start(250);
$('rec').classList.add('on');$('bRec').classList.add('danger');$('bRec').classList.remove('primary');$('bRec').lastChild.textContent='Стоп';
toast('Записываю ролик…')}
function stopRec(){if(rec&&rec.state!=='inactive'){try{rec.stop()}catch(e){}}else{recording=false;$('rec').classList.remove('on')}}
$('bPlay').addEventListener('click',function(){if(t>=TOTAL)t=0;playing=!playing;syncPlay()});
$('bRestart').addEventListener('click',function(){t=0;playing=true;syncPlay()});
$('bPrev').addEventListener('click',function(){jump(Math.max(0,sceneAt(t).i-1))});
$('bNext').addEventListener('click',function(){jump(Math.min(SCENES.length-1,sceneAt(t).i+1))});
