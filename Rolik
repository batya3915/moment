$('bRec').addEventListener('click',function(){if(recording)stopRec();else startRec()});
$('bFrame').addEventListener('click',function(){var a=document.createElement('a');a.href=cv.toDataURL('image/png');a.download='moment-frame.png';document.body.appendChild(a);a.click();a.remove();toast('Кадр PNG сохранён')});
$('bSave').addEventListener('click',function(){if(!recURL)return;var a=document.createElement('a');a.href=recURL;a.download='moment-team-reel.webm';document.body.appendChild(a);a.click();a.remove()});
$('bShare').addEventListener('click',function(){if(!recURL)return;fetch(recURL).then(function(r){return r.blob()}).then(function(b){var f=new File([b],'moment-team-reel.webm',{type:'video/webm'});if(navigator.canShare&&navigator.canShare({files:[f]}))return navigator.share({files:[f],title:'Момент — команда Эш'});throw 0}).catch(function(){toast('Открой «Скачать» или отправь файл из галереи')})});
